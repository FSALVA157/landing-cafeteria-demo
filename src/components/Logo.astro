---
// Monograma "J" dentro de un arco, como los respaldos de las sillas de terciopelo.
interface Props {
	class?: string;
	wordmark?: boolean;
}

const { class: className = '', wordmark = true } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
	<svg class="h-8 w-6 shrink-0" viewBox="0 0 48 64" aria-hidden="true" focusable="false">
		<path d="M4.5 61.5V24a19.5 19.5 0 0 1 39 0v37.5z" fill="none" stroke="currentColor" stroke-width="3.5"></path>
		<path
			d="M19 23h12M29 23v20a8 8 0 0 1-14.6 4.6"
			fill="none"
			stroke="currentColor"
			stroke-width="4.5"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
	{wordmark && <span class="font-serif text-lg tracking-wide whitespace-nowrap uppercase">Café Julia</span>}
</span>
