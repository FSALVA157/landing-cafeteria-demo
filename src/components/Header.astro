---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { links, nav } from '../data/site';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 px-4 md:px-8">
	<div class="mx-auto mt-6 flex max-w-6xl justify-center md:justify-start">
		<div
			class="pointer-events-auto relative z-10 flex w-max items-center gap-4 rounded-full border border-cocoa/10 bg-cream/80 py-2 pr-2 pl-4 shadow-lg shadow-cocoa/5 backdrop-blur-xl lg:gap-6"
		>
			<a href="#inicio" class="rounded-full text-cocoa" aria-label="Café Julia, ir al inicio">
				<Logo />
			</a>

			<nav aria-label="Principal" class="hidden md:block">
				<ul class="flex items-center gap-1">
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									data-nav-link
									class="rounded-full px-3 py-2 text-sm font-semibold text-cocoa-soft transition-colors duration-500 ease-fluid hover:bg-cocoa/5 hover:text-cocoa aria-[current=true]:bg-plaster aria-[current=true]:text-cocoa"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<a href={links.directions} target="_blank" rel="noopener" class="btn-primary hidden text-sm md:inline-flex">
				Cómo llegar
				<Icon name="arrowUpRight" class="size-4" />
			</a>

			<button
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="menu-movil"
				class="relative grid size-10 place-items-center rounded-full bg-cocoa text-cream transition-colors duration-500 ease-fluid hover:bg-cocoa-soft md:hidden"
			>
				<span class="sr-only">Abrir menú</span>
				<span
					aria-hidden="true"
					class="absolute h-0.5 w-4 rounded-full bg-current transition-all duration-500 ease-fluid -translate-y-1"
					data-bar="top"></span>
				<span
					aria-hidden="true"
					class="absolute h-0.5 w-4 rounded-full bg-current transition-all duration-500 ease-fluid translate-y-1"
					data-bar="bottom"></span>
			</button>
		</div>
	</div>

	<div
		id="menu-movil"
		data-menu
		class="pointer-events-none fixed inset-0 bg-cream/80 opacity-0 backdrop-blur-3xl transition-opacity duration-700 ease-fluid md:hidden"
		inert
	>
		<nav aria-label="Móvil" class="flex h-full flex-col justify-center px-6">
			<ul class="flex flex-col gap-2">
				{
					nav.map((item, i) => (
						<li class="overflow-hidden">
							<a
								href={item.href}
								data-menu-link
								style={`transition-delay: ${100 + i * 50}ms`}
								class="block translate-y-12 py-2 font-serif text-4xl text-cocoa opacity-0 transition-all duration-700 ease-fluid aria-[current=true]:text-terra"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a
				href={links.directions}
				target="_blank"
				rel="noopener"
				data-menu-link
				style="transition-delay: 350ms"
				class="btn-primary mt-8 w-max translate-y-12 opacity-0 transition-all duration-700 ease-fluid"
			>
				Cómo llegar
				<Icon name="arrowUpRight" class="size-4" />
			</a>
		</nav>
	</div>
</header>

<script>
	import { lenis } from '../scripts/motion';

	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
	const menu = document.querySelector<HTMLElement>('[data-menu]')!;
	const top = toggle.querySelector<HTMLElement>('[data-bar="top"]')!;
	const bottom = toggle.querySelector<HTMLElement>('[data-bar="bottom"]')!;
	const label = toggle.querySelector('.sr-only')!;
	const menuLinks = menu.querySelectorAll<HTMLElement>('[data-menu-link]');

	function setOpen(open: boolean) {
		toggle.setAttribute('aria-expanded', String(open));
		label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
		menu.toggleAttribute('inert', !open);
		menu.classList.toggle('opacity-0', !open);
		menu.classList.toggle('pointer-events-none', !open);
		menu.classList.toggle('pointer-events-auto', open);
		top.classList.toggle('-translate-y-1', !open);
		top.classList.toggle('rotate-45', open);
		bottom.classList.toggle('translate-y-1', !open);
		bottom.classList.toggle('-rotate-45', open);
		menuLinks.forEach((link) => {
			link.classList.toggle('opacity-0', !open);
			link.classList.toggle('translate-y-12', !open);
		});
		if (open) lenis?.stop();
		else lenis?.start();
	}

	toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
	menuLinks.forEach((link) => link.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			toggle.focus();
		}
	});
	window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
		if (event.matches) setOpen(false);
	});

	// Marca en la navegación la sección visible.
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], [data-menu-link][href^="#"]');
	const sections = [...new Set([...navLinks].map((link) => link.hash))]
		.map((hash) => document.querySelector<HTMLElement>(hash))
		.filter((section): section is HTMLElement => section !== null);

	const sectionObserver = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				navLinks.forEach((link) => {
					if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
					else link.removeAttribute('aria-current');
				});
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	sections.forEach((section) => sectionObserver.observe(section));
</script>
