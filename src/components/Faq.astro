---
import Icon from './Icon.astro';
import { faq } from '../data/site';
---

<section id="preguntas" aria-labelledby="preguntas-titulo" class="px-4 py-24 md:px-8">
	<div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_2fr]">
		<div>
			<p class="eyebrow" data-reveal>Preguntas frecuentes</p>
			<h2 id="preguntas-titulo" class="mt-4 text-4xl md:text-5xl" data-reveal>Antes de venir</h2>
		</div>
		<div class="flex flex-col gap-3" data-reveal>
			{
				faq.map((item) => (
					<details class="faq group rounded-2xl bg-plaster transition-colors duration-500 ease-fluid open:bg-cream open:shadow-lg open:shadow-cocoa/5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
							{item.q}
							<span class="grid size-8 shrink-0 place-items-center rounded-full bg-cream text-terra transition-transform duration-500 ease-fluid group-open:rotate-45">
								<Icon name="plus" class="size-4" />
							</span>
						</summary>
						<p class="px-6 pb-6 text-base text-cocoa-soft">{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
